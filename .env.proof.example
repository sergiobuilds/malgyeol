# Read-only proof capture
PUBLIC_BASE_URL=https://service.example
CLOUD_RUN_SERVICE_URL=https://service.example
CLOUD_RUN_SERVICE=malgyeol
CLOUD_RUN_REVISION=revision-name
GOOGLE_CLOUD_PROJECT=project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
SOLANA_RPC_URL=https://api.devnet.solana.com
EVIDENCE_OUTPUT_DIR=/tmp/malgyeol-evidence

# Vertex proof
VERTEX_ACCESS_TOKEN=short-lived-oauth-token
VERTEX_LIVE_AUDIO=0
TWILIO_ACCOUNT_SID=from-secret-manager
TWILIO_AUTH_TOKEN=from-secret-manager
TWILIO_LIVE_CALL_SID=

# ClawOps proof
CLAWOPS_API_KEY=from-secret-manager
CLAWOPS_ACCOUNT_ID=from-clawops-console
CLAWOPS_CALL_ID=
CLAWOPS_RECORDING_PATH=/tmp/malgyeol-call-recordings
AGENT_TOOL_SECRET=from-secret-manager
PHONE_HMAC_SECRET=replace-with-at-least-32-random-characters

# Supplier sandbox proof
U4_MERCHANT_SANDBOX=0
MERCHANT_SANDBOX_URL=
MERCHANT_SANDBOX_TOKEN=from-secret-manager

# Devnet proof, disabled by default
U3_LIVE_DEVNET=0
LIVE_DEVNET_PAYMENT=0
SOLANA_DEVNET_INSTITUTION_KEY=from-secret-manager
SOLANA_MERCHANT_ADDRESS=
SOLANA_DELIVERY_AUTHORITY=
DEVNET_PAYER_KEYPAIR=/secrets/devnet-payer.json
DEVNET_PAYER_KEY_PATH=/secrets/devnet-payer.json
SWIG_AUTHORITY_KEY_PATH=/secrets/swig-authority.json
OPERATOR_KEY_PATH=/secrets/operator.json
MERCHANT_ADDRESS=
SWIG_ACCOUNT_ADDRESS=
G3_EVIDENCE_PATH=/tmp/malgyeol-g3.json
G4_CHALLENGE_EVIDENCE_PATH=/tmp/malgyeol-g4-challenge.json
G4_SWIG_SETUP_EVIDENCE_PATH=/tmp/malgyeol-g4-setup.json
G4_EVIDENCE_PATH=/tmp/malgyeol-g4.json
