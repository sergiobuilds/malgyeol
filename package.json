    "@solana/pay-kit": "0.7.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@swig-wallet/classic": "2.1.0",
    "@swig-wallet/coder": "2.1.0",
