# Local synthetic mode
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=https://service.example
CASE_REPOSITORY=memory
PHONE_HMAC_SECRET=replace-with-at-least-32-random-characters
PHONE_SYNTHETIC_DEMO_BUDGET_KRW=50000
PUBLIC_PROOF_CASE_IDS=

# Vertex AI settings. Change CASE_REPOSITORY above to firestore in production.
GOOGLE_CLOUD_PROJECT=project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Server-side authorization and encrypted data
AGENT_TOOL_SECRET=from-secret-manager
AUDIT_READ_SECRET=from-secret-manager
PAID_ACTION_HMAC_SECRET=from-secret-manager
APPROVAL_DATA_KEY_BASE64=from-secret-manager

# Supplier and institution data mounts
SPECIAL_OFFER_API_KEY_FILE=/secrets/specialoffer/credential.json
FOOD_SUPPORT_BUDGET_FILE=/secrets/food-support/budgets.json
MERCHANT_SANDBOX_URL=

# Voice providers
TWILIO_ACCOUNT_SID=from-secret-manager
TWILIO_AUTH_TOKEN=from-secret-manager
CLAWOPS_API_KEY=from-secret-manager
CLAWOPS_SIGNING_KEY=from-secret-manager

# Devnet execution, disabled unless explicitly set to 1
LIVE_DEVNET_PAYMENT=0
SOLANA_DEVNET_INSTITUTION_KEY=from-secret-manager
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MERCHANT_ADDRESS=
SOLANA_DELIVERY_AUTHORITY=
SOLANA_TRACE_DIRECTORY=/tmp/malgyeol-x402
